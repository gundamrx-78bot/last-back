# 이 파일은 예시입니다. 실제 값은 .env.local(로컬) 또는 배포 서비스(Vercel) 환경변수에만 넣으세요.
# 절대 저장소에 올리지 마세요.
ANTHROPIC_API_KEY=
# 진단 agent 모델 (기본 claude-opus-5-5). 비용을 낮추려면 claude-sonnet-5-5 등으로 바꿉니다.
AI_MODEL=claude-opus-5-5
# low | medium | high  (기본 medium)
AI_EFFORT=medium
# agent 루프 최대 반복 횟수
AGENT_MAX_TURNS=8
# 서버 전체 하루 진단 상한 / IP당 10분 상한
DAILY_AI_LIMIT=300
PER_IP_LIMIT=5
# 이 API를 호출해도 되는 프론트 주소(쉼표로 여러 개). 배포하면 프론트 도메인을 추가하세요.
FRONT_ORIGIN=http://localhost:3000
